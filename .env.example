# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------------------
# Cadena de conexión principal. En Vercel usar la URL *pooled* del proveedor
# (Neon / Vercel Postgres / Supabase) para soportar entorno serverless.
DATABASE_URL="postgresql://usuario:password@localhost:5432/paki?schema=public"

# Conexión directa (sin pooler). La usan las migraciones de Prisma.
# En desarrollo local suele ser idéntica a DATABASE_URL.
DIRECT_URL="postgresql://usuario:password@localhost:5432/paki?schema=public"

# ---------------------------------------------------------------------------
# Autenticación (Auth.js / NextAuth v5)
# ---------------------------------------------------------------------------
# Secreto para firmar las sesiones JWT. Generar con: npx auth secret
# NUNCA reutilizar el valor de desarrollo en producción.
AUTH_SECRET="reemplazar-por-un-secreto-aleatorio-de-32-bytes"

# URL pública de la aplicación. En Vercel se infiere automáticamente.
# AUTH_URL="https://tu-dominio.vercel.app"

# ---------------------------------------------------------------------------
# Seed de datos demo (solo desarrollo)
# ---------------------------------------------------------------------------
# Contraseña asignada a los usuarios demo por el script de seed.
# Sin esta variable el seed no corre. NUNCA usar este valor en el local real.
SEED_PASSWORD="Demo1234!"

# El seed BORRA todos los datos antes de cargar los de ejemplo, por eso se
# niega a correr con NODE_ENV=production. Definir esta variable levanta ese
# bloqueo: no la actives salvo que sepas exactamente por qué.
# ALLOW_PRODUCTION_SEED=1

# ---------------------------------------------------------------------------
# Tests (opcional)
# ---------------------------------------------------------------------------
# Base contra la que corren los tests de integración. Tiene que ser una base
# aparte: el nombre debe contener "paki_test" o los tests abortan, para no
# destruir datos reales. Prepararla con: npm run test:setup
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paki_test?schema=public"

# ---------------------------------------------------------------------------
# Tienda pública (/tienda) — todas opcionales
# ---------------------------------------------------------------------------
# Lo que no se defina simplemente no se muestra.
# NEXT_PUBLIC_STORE_NAME="Paki"
# WhatsApp con código de país y sin signos: habilita el botón "Consultar".
# NEXT_PUBLIC_STORE_WHATSAPP="5491123456789"
# NEXT_PUBLIC_STORE_ADDRESS="Av. Siempreviva 742, Ciudad"
# NEXT_PUBLIC_STORE_HOURS="Lun a Sáb de 10 a 20 h"
# NEXT_PUBLIC_STORE_INSTAGRAM="@mi.local"

# ---------------------------------------------------------------------------
# Consultas y seguimiento — todas opcionales
# ---------------------------------------------------------------------------
# URL pública de la aplicación (se usa en los enlaces de los avisos diarios).
# APP_URL="https://tu-dominio.vercel.app"

# IA para los borradores de respuesta (Groq). Sin clave se usa un asistente
# simple con plantillas. NUNCA subas la clave real al repositorio.
# GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"
# AI_PROVIDER="mock"   # fuerza el asistente simple aunque haya clave

# Cron de avisos diarios: 16 caracteres o más. Sin esto el endpoint queda cerrado.
# CRON_SECRET=""

# WhatsApp Cloud API. En "mock" (por defecto) no se envía nada a nadie.
# WHATSAPP_MODE="live"
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_VERIFY_TOKEN=""
# META_APP_SECRET=""
# WHATSAPP_ARGENTINA_DROP_NINE="true"   # solo si Meta rechaza números (error 131030)
# Plantillas aprobadas por Meta (claves: PRIMERO, REENGAGE, RETOMAR, INFO, CITA):
# Aviso al dueño cuando entra una consulta por la tienda. Números separados por coma;
# si no se define, se usa NEXT_PUBLIC_STORE_WHATSAPP. Plantilla clave AVISO.
# STORE_NOTIFY_WHATSAPP="5493731667332"
# WHATSAPP_TEMPLATE_AVISO_NAME="aviso_consulta_nueva"
# WHATSAPP_TEMPLATE_AVISO_TEXT="Nueva consulta en {{1}} de {{2}} (tel. {{3}}) sobre {{4}}: {{5}}. Respondela desde el panel de consultas."
# WHATSAPP_TEMPLATE_REENGAGE_NAME="recontacto_consulta"
# WHATSAPP_TEMPLATE_REENGAGE_TEXT="Hola {{1}}, te escribe {{2}} de Paki por tu consulta. ¿Seguimos la conversación por acá?"

