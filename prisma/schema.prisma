// Sistema de Gestión Interna — Local de Venta de Celulares
// Modelo de datos: cada celular es una UNIDAD INDIVIDUAL (Device) con IMEI único.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMINISTRADOR
  VENDEDOR
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

/// Estado físico/comercial del equipo. Ampliable con `ALTER TYPE ... ADD VALUE`.
enum DeviceCondition {
  NUEVO_SELLADO
  /// Equipo nuevo, sin uso, pero con la caja o el film abierto.
  NUEVO_SIN_SELLAR
  USADO
}

/// Tipo de equipo que se gestiona como unidad individual.
/// Determina qué campos aplican: un parlante no tiene IMEI ni batería medible,
/// una cámara no tiene capacidad de almacenamiento interno.
enum DeviceType {
  CELULAR
  TABLET
  RELOJ
  PARLANTE
  CAMARA
  OTRO
}

/// Rubro del accesorio. Ampliable con `ALTER TYPE ... ADD VALUE`.
enum AccessoryCategory {
  FUNDA
  TEMPLADO
  PROTECTOR
  CARGADOR
  CABLE
  AURICULARES
  SOPORTE
  BATERIA_EXTERNA
  OTRO
}

/// Estado de inventario, separado del estado físico del equipo.
enum InventoryStatus {
  DISPONIBLE
  VENDIDO
  RESERVADO
  INACTIVO
}

enum StockMovementType {
  INGRESO
  VENTA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  DEVOLUCION
  BAJA
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  DEBITO
  CREDITO
  OTRO
}

enum SaleStatus {
  COMPLETADA
  ANULADA
}

/// Quién financia la venta.
/// Solo FINANCIACION_LOCAL genera deuda del cliente con el local y, por lo
/// tanto, cuotas a reclamar. En TARJETA el banco liquida el total al local.
enum FinancingType {
  CONTADO
  TARJETA
  FINANCIACION_LOCAL
}

/// El estado VENCIDA no se almacena: se deriva de `dueDate` contra la fecha
/// actual, para que no exista estado obsoleto ni haga falta una tarea programada.
enum InstallmentStatus {
  PENDIENTE
  PAGADA
  ANULADA
}

enum PurchaseStatus {
  BORRADOR
  CONFIRMADA
  ANULADA
}

enum AuditAction {
  LOGIN
  CREAR_PRODUCTO
  MODIFICAR_PRODUCTO
  MODIFICAR_PRECIO
  BAJA_PRODUCTO
  INGRESO_STOCK
  AJUSTE_STOCK
  REGISTRAR_VENTA
  ANULAR_VENTA
  CREAR_USUARIO
  MODIFICAR_USUARIO
  DESACTIVAR_USUARIO
  CREAR_CLIENTE
  MODIFICAR_CLIENTE
  CREAR_COMPRA
  CONFIRMAR_COMPRA
  REGISTRAR_PAGO_CUOTA
  ANULAR_PAGO_CUOTA
  ANULAR_COMPRA
  CREAR_PROVEEDOR
  MODIFICAR_PROVEEDOR
  CREAR_ACCESORIO
  MODIFICAR_ACCESORIO
  BAJA_ACCESORIO
  MODIFICAR_CONFIGURACION
  ENVIAR_MENSAJE
  MODIFICAR_SEGUIMIENTO
  REASIGNAR_CONSULTA
  CREAR_CONTACTO
  NOTA_INTERNA
  GENERAR_AVISOS
}

// ---------------------------------------------------------------------------
// Consultas y seguimiento de clientes
// ---------------------------------------------------------------------------

/// Etapa de una consulta en el seguimiento de ventas.
enum LeadStage {
  CONSULTA
  PRECIO_ENVIADO
  RESERVADO
  VENDIDO
  EN_PAUSA
  PERDIDO
}

/// Por dónde llegó la consulta.
enum LeadSource {
  WEB
  WHATSAPP
  MANUAL
}

enum LeadPriority {
  ALTA
  MEDIA
  BAJA
}

enum MessageDirection {
  ENTRANTE
  SALIENTE
}

enum MessageStatus {
  RECIBIDO
  ENVIADO
  ENTREGADO
  LEIDO
  FALLIDO
}

enum DraftStatus {
  PENDIENTE
  ENVIADO
  DESCARTADO
}

// ---------------------------------------------------------------------------
// Usuarios
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(VENDEDOR)
  status       UserStatus @default(ACTIVO)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  devicesCreated     Device[]        @relation("DeviceCreatedBy")
  devicesUpdated     Device[]        @relation("DeviceUpdatedBy")
  accessoriesCreated Accessory[]     @relation("AccessoryCreatedBy")
  accessoriesUpdated Accessory[]     @relation("AccessoryUpdatedBy")
  sales              Sale[]          @relation("SaleSeller")
  salesCancelled     Sale[]          @relation("SaleCancelledBy")
  stockMovements     StockMovement[]
  auditLogs          AuditLog[]
  customers          Customer[]
  purchases          Purchase[]
  installments       Installment[]

  leadsAssigned      Lead[]              @relation("LeadAssignee")
  leadMessagesSent   LeadMessage[]
  leadNotes          LeadNote[]
  leadStageChanges   LeadStageChange[]
  staffNotifications StaffNotification[]

  @@index([role])
  @@index([status])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Catálogo: Marca / Modelo
// ---------------------------------------------------------------------------

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models DeviceModel[]

  @@map("brands")
}

model DeviceModel {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  /// Umbral de alerta de stock bajo para este modelo.
  minStock  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  image         ModelImage?
  devices       Device[]
  purchaseItems PurchaseItem[]

  @@unique([brandId, name])
  @@index([brandId])
  @@map("device_models")
}

// ---------------------------------------------------------------------------
// Device — unidad física individual
// ---------------------------------------------------------------------------

model Device {
  id      String     @id @default(cuid())
  type    DeviceType @default(CELULAR)
  modelId String
  color   String

  /// Capacidad de almacenamiento en GB (32, 64, 128, 256, 512, 1024...).
  /// Se guarda numérico para permitir ordenar y agregar valores sin migración.
  /// Nulo en equipos sin almacenamiento propio, como un parlante.
  storageGb Int?

  condition      DeviceCondition
  /// Obligatorio para equipos USADO. Rango 0-100 (validado por CHECK constraint).
  batteryPercent Int?
  /// Único cuando está presente. Nulo permitido para accesorios sin IMEI.
  imei           String?         @unique
  serialNumber   String?

  purchasePrice Decimal? @db.Decimal(12, 2)
  salePrice     Decimal  @db.Decimal(12, 2)

  inventoryStatus InventoryStatus @default(DISPONIBLE)
  entryDate       DateTime        @default(now())
  notes           String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  model          DeviceModel     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("DeviceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?           @relation("DeviceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  purchaseItem   PurchaseItem?
  leads          Lead[]
  photos         DevicePhoto[]
  /// Si no tiene fotos propias, la tienda usa la imagen de su modelo (si la hay).
  /// Apagarlo fuerza el dibujo ilustrativo.
  useModelImage  Boolean         @default(true)

  @@index([modelId])
  @@index([inventoryStatus])
  @@index([condition])
  @@index([entryDate])
  @@index([salePrice])
  @@index([inventoryStatus, modelId])
  @@index([type])
  @@index([type, inventoryStatus])
  /// Índice trigram para buscar por IMEI parcial. Declarado acá para que
  /// Prisma lo reconozca y no intente descartarlo en cada migración.
  @@index([imei(ops: raw("gin_trgm_ops"))], type: Gin, map: "devices_imei_trgm_idx")
  @@map("devices")
}

/// Producto que se gestiona POR CANTIDAD, no por unidad individual.
///
/// Treinta fundas iguales son un registro con stock 30, no treinta registros.
/// Por eso no lleva IMEI, número de serie ni estado de inventario por unidad:
/// el stock es un número que sube y baja mediante movimientos.
model Accessory {
  id       String            @id @default(cuid())
  category AccessoryCategory
  name     String
  /// Marca en texto libre: los accesorios suelen ser genéricos.
  brand    String?
  /// Código interno opcional, único cuando está presente.
  sku      String?           @unique

  salePrice Decimal @db.Decimal(12, 2)

  /// Cantidad en stock. Nunca se edita a mano desde la aplicación:
  /// siempre cambia a través de un StockMovement.
  stockQuantity Int @default(0)
  minStock      Int @default(0)

  /// Baja lógica: un accesorio con historial nunca se elimina.
  isActive Boolean @default(true)
  notes    String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy      User            @relation("AccessoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?           @relation("AccessoryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]

  @@index([category])
  @@index([isActive])
  @@index([name])
  /// Búsqueda parcial por nombre de accesorio.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "accessories_name_trgm_idx")
  @@map("accessories")
}

// ---------------------------------------------------------------------------
// Clientes
// ---------------------------------------------------------------------------

model Customer {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  dni         String?  @unique
  phone       String?
  email       String?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sales     Sale[]

  @@index([lastName, firstName])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Ventas
// ---------------------------------------------------------------------------

model Sale {
  id         String   @id @default(cuid())
  /// Comprobante interno correlativo (V-00000001).
  saleNumber String   @unique
  saleDate   DateTime @default(now())

  sellerId   String
  customerId String?

  subtotal         Decimal @db.Decimal(12, 2)
  discount         Decimal @default(0) @db.Decimal(12, 2)
  /// Recargo por financiación (interés), aplicado sobre `subtotal - discount`.
  /// El porcentaje se guarda junto al importe para poder reconstruir la
  /// operación aunque el plan de financiación cambie después.
  surchargePercent Decimal @default(0) @db.Decimal(6, 2)
  surchargeAmount  Decimal @default(0) @db.Decimal(12, 2)
  /// total = subtotal - discount + surchargeAmount
  total            Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETADA)
  notes         String?

  financingType    FinancingType @default(CONTADO)
  /// Cantidad de cuotas pactadas (tarjeta o financiación propia).
  installmentCount Int?

  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller         User            @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  cancelledBy    User?           @relation("SaleCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items          SaleItem[]
  stockMovements StockMovement[]
  installments   Installment[]

  @@index([saleDate])
  @@index([sellerId])
  @@index([status])
  @@index([customerId])
  @@index([status, saleDate])
  @@index([financingType])
  @@map("sales")
}

/// Plan de financiación sugerido: recargo (interés) por cantidad de cuotas.
///
/// Es un valor por defecto: el vendedor puede cambiar el porcentaje al
/// registrar cada venta. La venta guarda el porcentaje que realmente se aplicó,
/// por eso editar o borrar un plan nunca altera ventas ya registradas.
/// Solo tiene sentido para TARJETA y FINANCIACION_LOCAL (CHECK en la base).
model FinancingPlan {
  id               String        @id @default(cuid())
  type             FinancingType
  installments     Int
  /// 0 = cuotas sin interés.
  surchargePercent Decimal       @default(0) @db.Decimal(6, 2)
  /// Un plan inactivo no se ofrece en la venta ni en la tienda.
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([type, installments])
  @@index([isActive])
  @@map("financing_plans")
}

/// Cuota de una venta financiada por el local.
/// Solo se generan cuando `Sale.financingType = FINANCIACION_LOCAL`.
model Installment {
  id     String @id @default(cuid())
  saleId String
  /// Número de cuota dentro del plan (1..n).
  number Int

  dueDate DateTime
  amount  Decimal  @db.Decimal(12, 2)

  status        InstallmentStatus @default(PENDIENTE)
  paidAt        DateTime?
  /// Monto efectivamente cobrado, que puede diferir del pactado.
  paidAmount    Decimal?          @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  notes         String?

  registeredById String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sale         Sale  @relation(fields: [saleId], references: [id], onDelete: Restrict)
  registeredBy User? @relation(fields: [registeredById], references: [id], onDelete: Restrict)

  @@unique([saleId, number])
  @@index([dueDate])
  @@index([status])
  @@index([status, dueDate])
  @@map("installments")
}

/// Línea de venta. Refiere a UN equipo individual o a UN accesorio por
/// cantidad, nunca a los dos (garantizado por CHECK en la base).
model SaleItem {
  id     String @id @default(cuid())
  saleId String

  deviceId    String?
  accessoryId String?

  /// Siempre 1 para equipos individuales; la cantidad vendida para accesorios.
  quantity Int @default(1)

  /// Precio unitario congelado al momento de la venta.
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  sale      Sale       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  device    Device?    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  accessory Accessory? @relation(fields: [accessoryId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([deviceId])
  @@index([accessoryId])
  @@map("sale_items")
}

// ---------------------------------------------------------------------------
// Movimientos de stock — histórico inmutable
// ---------------------------------------------------------------------------

/// Movimiento de stock. Afecta a un equipo individual (cambio de estado) o a
/// un accesorio (variación de cantidad), nunca a los dos.
model StockMovement {
  id          String            @id @default(cuid())
  deviceId    String?
  accessoryId String?
  type        StockMovementType
  reason      String
  userId      String
  saleId      String?
  notes       String?

  /// Solo para equipos individuales.
  previousStatus InventoryStatus?
  newStatus      InventoryStatus?

  /// Solo para accesorios: variación aplicada (+5 al ingresar, −2 al vender)
  /// y stock resultante, para poder reconstruir el historial.
  quantityDelta Int?
  quantityAfter Int?

  createdAt DateTime @default(now())

  device    Device?    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  accessory Accessory? @relation(fields: [accessoryId], references: [id], onDelete: Restrict)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  sale      Sale?      @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([deviceId])
  @@index([accessoryId])
  @@index([createdAt])
  @@index([type])
  @@index([userId])
  @@index([saleId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Auditoría — histórico inmutable
// ---------------------------------------------------------------------------

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  action    AuditAction
  entity    String
  entityId  String
  /// { campo: { anterior, nuevo } } para cambios importantes.
  changes   Json?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Proveedores y compras
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  cuit      String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@map("suppliers")
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String
  purchaseDate   DateTime       @default(now())
  total          Decimal        @db.Decimal(12, 2)
  status         PurchaseStatus @default(BORRADOR)
  userId         String
  notes          String?
  confirmedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    PurchaseItem[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@index([status])
  @@map("purchases")
}

/**
 * Ítem de una compra. Refleja las dos formas de contar stock del sistema:
 * - **Equipo**: describe UNA unidad a ingresar. Al confirmar la compra se crea
 * el `Device` y se enlaza mediante `deviceId`.
 * - **Accesorio**: repone un accesorio YA existente del catálogo, sumando
 * `quantity` unidades a su stock.
 * Un ítem es de un tipo o del otro, nunca de los dos (CHECK en la base).
 */
model PurchaseItem {
  id         String @id @default(cuid())
  purchaseId String

  // --- Equipo a ingresar --------------------------------------------------
  modelId        String?
  deviceType     DeviceType?
  color          String?
  storageGb      Int?
  condition      DeviceCondition?
  batteryPercent Int?
  imei           String?
  serialNumber   String?
  /// Precio con el que el equipo entra al inventario.
  salePrice      Decimal?         @db.Decimal(12, 2)

  // --- Accesorio a reponer ------------------------------------------------
  accessoryId String?

  /// Siempre 1 para equipos; las unidades compradas para accesorios.
  quantity Int @default(1)

  /// Costo unitario pagado al proveedor.
  unitCost Decimal @db.Decimal(12, 2)

  /// Device generado al confirmar la compra.
  deviceId String? @unique

  purchase  Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  model     DeviceModel? @relation(fields: [modelId], references: [id], onDelete: Restrict)
  accessory Accessory?   @relation(fields: [accessoryId], references: [id], onDelete: Restrict)
  device    Device?      @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([modelId])
  @@index([accessoryId])
  @@map("purchase_items")
}

// ---------------------------------------------------------------------------
// Consultas (bandeja) y seguimiento
// ---------------------------------------------------------------------------

/// Persona interesada en comprar. Una misma persona es UNA consulta aunque
/// escriba por distintos canales: se unifica por teléfono o por correo.
model Lead {
  id             String     @id @default(cuid())
  fullName       String
  /// Teléfono normalizado (+549…). Único cuando está presente.
  phone          String?    @unique
  /// Correo en minúsculas. Único cuando está presente.
  email          String?    @unique
  source         LeadSource
  stage          LeadStage  @default(CONSULTA)
  /// Desde cuándo está en la etapa actual.
  stageChangedAt DateTime   @default(now())

  assigneeId   String?
  /// Equipo por el que consultó, si lo hizo desde la tienda.
  deviceId     String?
  interestNote String?

  nextContactAt   DateTime?
  nextContactNote String?
  pauseReason     String?
  lostReason      String?

  /// Prioridad sugerida por la IA; la manual siempre manda.
  aiPriority       LeadPriority?
  aiPriorityReason String?
  manualPriority   LeadPriority?

  lastInboundAt DateTime?
  lastMessageAt DateTime?
  /// El último mensaje es del cliente y nadie respondió todavía.
  needsReply    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignee     User?             @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  device       Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  messages     LeadMessage[]
  drafts       LeadDraft[]
  notes        LeadNote[]
  stageChanges LeadStageChange[]

  @@index([stage])
  @@index([assigneeId])
  @@index([nextContactAt])
  @@index([lastMessageAt])
  @@index([needsReply])
  @@map("leads")
}

model LeadMessage {
  id             String           @id @default(cuid())
  leadId         String
  direction      MessageDirection
  channel        LeadSource
  body           String
  /// Texto sin mayúsculas, tildes ni signos: base del control anti-duplicados.
  normalizedText String
  status         MessageStatus
  /// Id del mensaje en el canal (wamid…). Evita procesar dos veces el mismo aviso.
  externalId     String?          @unique
  sentById       String?
  createdAt      DateTime         @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sentBy User? @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_messages")
}

/// Borrador de respuesta. Nunca se envía solo: lo revisa y envía una persona.
model LeadDraft {
  id          String      @id @default(cuid())
  leadId      String
  body        String
  generatedBy String
  status      DraftStatus @default(PENDIENTE)
  createdAt   DateTime    @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, status])
  @@map("lead_drafts")
}

/// Notas internas. Nunca se envían al cliente ni se le pasan a la IA.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@map("lead_notes")
}

model LeadStageChange {
  id        String     @id @default(cuid())
  leadId    String
  fromStage LeadStage?
  toStage   LeadStage
  userId    String?
  createdAt DateTime   @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_stage_changes")
}

/// Aviso diario a cada responsable. Único por persona y día: si el cron corre
/// dos veces, la segunda no vuelve a avisar.
model StaffNotification {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  /// Día calendario al que corresponde (medianoche UTC).
  forDate   DateTime @db.Date
  subject   String
  body      String
  dueToday  Int      @default(0)
  overdue   Int      @default(0)
  channel   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, forDate])
  @@map("staff_notifications")
}

/// Registro de lo que llega por los webhooks, para diagnosticar integraciones.
model WebhookLog {
  id          String   @id @default(cuid())
  source      String
  signatureOk Boolean
  kind        String?
  externalId  String?
  outcome     String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("webhook_logs")
}

// ---------------------------------------------------------------------------
// Fotos de los equipos
// ---------------------------------------------------------------------------

/// Foto de un equipo. Se guarda en la base (el navegador ya la redujo antes de
/// subirla), así no hace falta un servicio de archivos aparte.
///
/// Las consultas que listan equipos NUNCA deben seleccionar `data`: solo el id,
/// y la imagen se pide aparte (`/api/fotos/<id>`).
model DevicePhoto {
  id          String   @id @default(cuid())
  deviceId    String
  data        Bytes
  contentType String
  sizeBytes   Int
  /// Orden de la galería: la de menor posición es la principal.
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, position])
  @@map("device_photos")
}

/// Imagen de un modelo (por ejemplo, una foto de catálogo del iPhone 15). La
/// usa la tienda mientras un equipo no tenga fotos propias. Una por modelo;
/// al reemplazarla se crea otra fila con otro id, así la imagen se cachea para siempre.
model ModelImage {
  id          String   @id @default(cuid())
  modelId     String   @unique
  data        Bytes
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  model DeviceModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("model_images")
}
